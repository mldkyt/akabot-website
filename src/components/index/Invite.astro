---
import styles from "./invite.module.css";
---

<div class={styles.wrapper}>
    <p style="color: yellow;">Note: Akabot is slowly getting replaced by Nekona, please invite Nekona instead.</p>
    <p>Nekona is a full rewrite of Akabot, designed to be more modular and easier to work on. It is faster and more stable than Akabot.</p>

    <a href="https://discord.com/discovery/applications/1426903542601613444">
        <button class={styles.invitebtn}>Invite Nekona Today!</button>
    </a>
    <a href="https://discord.com/discovery/applications/1172922944033411243">
        <button class={styles.sourcebtn}>Invite Akabot anyway</button>
    </a>
    <a href="https://codeberg.org/Akabot">
        <button class={styles.sourcebtn}>View the source code</button>
    </a>
</div>
